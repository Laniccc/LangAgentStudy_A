# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 可选：通用 OpenAI 兼容配置（未设置 DeepSeek 时回退）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# 通用 chat 模式 temperature（research 模式见下方分角色配置）
LLM_TEMPERATURE=0

# 研究工作流：分 Agent temperature
ORCHESTRATOR_TEMPERATURE=0.2
SUB_AGENT_TEMPERATURE=0.1
REVIEWER_TEMPERATURE=0.1

# LLM 请求超时（秒）与失败重试次数（缓解偶发网络抖动）
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=3

# 用户上传图片视觉解读（须支持 image 输入；未设 VISION_API_KEY 时回退 DEEPSEEK/OPENAI）
# VISION_API_KEY=
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=gpt-4o-mini
# VISION_TEMPERATURE=0
# IMAGE_MAX_BYTES=8388608
# 启动时立即为每张图生成 caption 并建向量索引（1=是；默认 0=首次检索/阅读时再生成，省 API）
# IMAGE_CAPTION_ON_LOAD=0

# 若需代理访问 API（按本机代理端口修改，不需要则留空或删除）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
